{
  "kind": "collectionType",
  "collectionName": "recipes",
  "info": {
    "singularName": "recipe",
    "pluralName": "recipes",
    "displayName": "Recipe"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string"
    },
    "Image": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Slug": {
      "type": "uid",
      "targetField": "Title"
    },
    "Description": {
      "type": "text"
    },
    "products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "mappedBy": "recipes"
    },
    "Ingrediens": {
      "type": "component",
      "component": "recipes.ingredients",
      "repeatable": true
    },
    "Step": {
      "type": "component",
      "component": "recipes.steps",
      "repeatable": true
    },
    "Difficulty": {
      "type": "enumeration",
      "enum": [
        "Let",
        "Mellem",
        "Svær"
      ]
    },
    "AntalPersoner": {
      "type": "integer"
    },
    "Tid": {
      "type": "component",
      "component": "recipes.time-taken",
      "repeatable": false
    }
  }
}
